# Backend API base. Use the LAN IP (e.g. http://192.168.1.163:4000) so phones
# on the same Wi-Fi can reach it, OR leave empty to same-origin via Next.js
# rewrites (preferred when serving via Caddy / ngrok).
NEXT_PUBLIC_API_BASE=http://localhost:4000

# Public-facing URL where customers reach this Next.js app from the internet.
# Used as the default base for table QR codes in the admin panel.
#   Caddy:  https://pos.example.com
#   ngrok:  https://abc123.ngrok-free.app
# Leave blank to fall back to the backend's PUBLIC_BASE_URL or window.origin.
NEXT_PUBLIC_PUBLIC_BASE=
