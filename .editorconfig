root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true
max_line_length = 100

[*.{md,mdx}]
trim_trailing_whitespace = false
max_line_length = off

[*.{bat,cmd}]
end_of_line = crlf

[*.{ps1,psm1}]
end_of_line = crlf

[*.{sql}]
indent_size = 4

[Makefile]
indent_style = tab

[*.{dart}]
indent_size = 2
max_line_length = 120
