# Copy to docker/.env (or repo-root .env for compose variable substitution)
# NEVER commit real secrets.

# --- Published ports (Caddy reverse proxy) ---
HTTP_PORT=8080
HTTPS_PORT=443

# Leave CADDY_DOMAIN empty for HTTP-only (LAN lab).
# Set to your public hostname for automatic Let's Encrypt HTTPS.
CADDY_DOMAIN=
ACME_EMAIL=admin@example.com

# --- PostgreSQL ---
PGUSER=pos
PGPASSWORD=change-me-use-openssl-rand-hex-32
PGDATABASE=pos_v2

# --- Backend (passed to backend service) ---
JWT_SECRET=change-me-use-openssl-rand-hex-32
JWT_EXPIRES_IN=2h
BCRYPT_COST=12

# Comma-separated browser origins (include your public URL)
CORS_ORIGINS=http://localhost:8080

# Public customer QR base (https://your-domain or http://host:8080 for lab)
PUBLIC_BASE_URL=http://localhost:8080

# Admin mutations (stores/users/menu/printer config) require LAN IP unless
# user has mobile_admin / store_admin permission.
ADMIN_CONTROL_LAN_ONLY=true

# Web Push (optional) — generate: cd backend && npm run rotate-secrets
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Thermal printer on host/LAN (leave blank to skip hardware print in container)
PRINTER_ENABLED=false
PRINTER_HOST=
PRINTER_PORT=9100
PRINTER_RENDER_MODE=image

# Rate limits (optional overrides)
# PUBLIC_ORDER_RATE_LIMIT_MAX=120
