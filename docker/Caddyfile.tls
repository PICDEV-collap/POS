# HTTPS + automatic certificates (set CADDY_DOMAIN and ACME_EMAIL in docker/.env)
# Usage:
#   docker compose -f docker-compose.yml -f docker-compose.tls.yml --env-file docker/.env up -d

{
	email {$ACME_EMAIL}
}

(common) {
	encode gzip zstd
	handle /api/* {
		reverse_proxy backend:4000
	}
	handle /uploads/* {
		reverse_proxy backend:4000
	}
	handle /socket.io/* {
		reverse_proxy backend:4000
	}
	handle {
		reverse_proxy web:3000
	}
}

{$CADDY_DOMAIN} {
	import common
}

:80 {
	redir https://{host}{uri} permanent
}
