# POS V2 — Next.js customer/staff/admin web (standalone output)
FROM node:20-bookworm-slim AS deps
WORKDIR /app
COPY customer-web/package.json customer-web/package-lock.json* ./
RUN npm ci

FROM node:20-bookworm-slim AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY customer-web/ ./
ENV NEXT_TELEMETRY_DISABLED=1
RUN npm run build

FROM node:20-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000 \
    HOSTNAME=0.0.0.0

RUN useradd --system --uid 10002 --create-home posweb
USER posweb

COPY --from=builder --chown=posweb:posweb /app/public ./public
COPY --from=builder --chown=posweb:posweb /app/.next/standalone ./
COPY --from=builder --chown=posweb:posweb /app/.next/static ./.next/static

EXPOSE 3000
CMD ["node", "server.js"]
