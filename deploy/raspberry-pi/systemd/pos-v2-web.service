[Unit]
Description=POS V2 Web App
Wants=network-online.target pos-v2-backend.service
After=network-online.target pos-v2-backend.service

[Service]
Type=simple
User=__APP_USER__
Group=__APP_GROUP__
WorkingDirectory=__INSTALL_DIR__/customer-web
EnvironmentFile=__ETC_DIR__/web.env
ExecStart=/usr/bin/npm run start
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=__INSTALL_DIR__ __LOG_DIR__
SyslogIdentifier=pos-v2-web

[Install]
WantedBy=multi-user.target
