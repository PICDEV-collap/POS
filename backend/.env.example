# Copy to .env and edit for your environment.
PORT=4000

# PostgreSQL connection
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=pos_v2

# JWT
JWT_SECRET=change-me-in-production-please
JWT_EXPIRES_IN=12h

# Production hardening (see deploy/SECURITY.md)
# NODE_ENV=production
# LISTEN_HOST=127.0.0.1
# BCRYPT_COST=12
# ADMIN_CONTROL_LAN_ONLY=true

# CORS — comma-separated list of origins allowed to call the API.
# Add your Caddy/ngrok domain here too so the customer-web can reach the API.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Public-facing URL where customers reach the customer-web frontend over the
# internet (so the QR codes work when scanned outside the LAN).
#   Caddy:  https://pos.example.com
#   ngrok:  https://abc123.ngrok-free.app
# Leave blank for LAN-only / development.
# ngrok static domain (QR ลูกค้า + admin ผ่าน tunnel เดียวกัน):
# PUBLIC_BASE_URL=https://my-shop.ngrok-free.app
PUBLIC_BASE_URL=

# When using ngrok for admin + ADMIN_CONTROL_LAN_ONLY=true, allow your static
# tunnel hostname so menu/store edits work through HTTPS (comma-separated).
# ADMIN_CONTROL_TUNNEL_HOSTS=my-shop.ngrok-free.app

# Optional allowlist for customer QR ordering when `ordering_require_private_ip`
# is enabled but QR traffic enters through a public reverse proxy/tunnel.
# Use this only for the shop's fixed WAN IP/CIDR. Leave blank for LAN-only QR.
# Example: PUBLIC_ORDER_ALLOWED_CIDRS=203.0.113.10/32,198.51.100.0/24
PUBLIC_ORDER_ALLOWED_CIDRS=

# Thermal printer (A70Pro / ESC-POS over TCP)
# Leave PRINTER_HOST blank to disable real printing (requests succeed with skipped=true)
PRINTER_ENABLED=true
PRINTER_HOST=
PRINTER_PORT=9100
PRINTER_TIMEOUT_MS=3000
PRINTER_THAI_CP=21
PRINTER_WIDTH_CHARS=42

# Render mode: text (default — TIS-620 + printer's font) or image (canvas → ESC/POS raster)
# Use 'image' if printer Thai font is broken (sara/maitaikhu placement off)
PRINTER_RENDER_MODE=text
PRINTER_WIDTH_PX=384            # 384 = 58mm paper, 576 = 80mm
PRINTER_FONT_PATH=              # Defaults to C:/Windows/Fonts/tahoma.ttf if blank

# Web Push (generate keys: node -e "console.log(require('web-push').generateVAPIDKeys())")
VAPID_SUBJECT=mailto:admin@pos-v2.local
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
